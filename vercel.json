{
  "version": 2,
  "functions": {
    "api/log-pageview.ts": {
      "includeFiles": "config/log-filters.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/tdx/(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
