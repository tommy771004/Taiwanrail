# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TDX API Credentials (REQUIRED on Vercel Production for /api/tdx/* live data)
# Register at https://tdx.transportdata.tw/ → 會員中心 → 我的金鑰
# Without these, LiveBoard / Metro live / OD fallback return 503 {"error":"Token Error"}.
# Set the same names in Vercel → Project → Settings → Environment Variables (Production).
TDX_CLIENT_ID=""
TDX_CLIENT_SECRET=""

# DEPRECATED — never reintroduce client-exposed TDX keys (use server-only vars above).
# VITE_TDX_CLIENT_ID=""
# VITE_TDX_CLIENT_SECRET=""

# Neon PostgreSQL 連線字串（用於使用者查詢 log）
# 從 Neon Console > Project > Connection Details 取得
# 格式：postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Cross-project telemetry (server-only; never expose as VITE_* variables)
# TELEMETRY_INGEST_URL="https://<admin-console-domain>/api/telemetry/ingest"
# TELEMETRY_PROJECT_KEY="rail"
# TELEMETRY_INGEST_KEY="<same secret as the admin console TELEMETRY_INGEST_KEYS.rail>"
