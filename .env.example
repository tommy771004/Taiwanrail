# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TDX API Credentials (REQUIRED on Vercel Production for /api/tdx/* live data)
# Register at https://tdx.transportdata.tw/ → 會員中心 → 我的金鑰
# Without these, LiveBoard / Metro live / OD fallback return 503 {"error":"Token Error"}.
# Set the same names in Vercel → Project → Settings → Environment Variables (Production).
TDX_CLIENT_ID=""
TDX_CLIENT_SECRET=""

# GATE_SECRET: HMAC secret for Gate tickets on live gateways (TDX / geocode / YouBike).
# REQUIRED in production (Vercel). Rotation invalidates all outstanding tickets.
# Local dev: optional — an ephemeral process-local secret is used when unset.
GATE_SECRET=""

# DEPRECATED — never reintroduce client-exposed TDX keys (use server-only vars above).
# VITE_TDX_CLIENT_ID=""
# VITE_TDX_CLIENT_SECRET=""

# Neon PostgreSQL 連線字串（用於使用者查詢 log、意見回饋、推廣曝光／點擊 audit_log）
# 從 Neon Console > Project > Connection Details 取得
# 格式：postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# 聯盟／合作推廣共用資料庫（docs/affiliate-integration-spec.md）
# 獨立於 DATABASE_URL 的 PostgreSQL，存放跨專案共用的 affiliates 表。
# Server-only：絕不可加 VITE_ 前綴，也不可送到瀏覽器。
# 未設定時 /api/affiliates 回傳 503 + offers: []，前端不顯示推廣區塊，
# 且**不得**改用 DATABASE_URL 代替。建表：psql "$SUP_DATABASE_URL" -f db/affiliates.sql
SUP_DATABASE_URL=""

# 本專案在共用 affiliates 表中的分區名稱（project_name）。
# 未設定時預設為 taiwanrail；改名必須同時建立 DB migration。
AFFILIATE_PROJECT_NAME="taiwanrail"

# Cross-project telemetry (server-only; never expose as VITE_* variables)
# TELEMETRY_INGEST_URL="https://<admin-console-domain>/api/telemetry/ingest"
# TELEMETRY_PROJECT_KEY="rail"
# TELEMETRY_INGEST_KEY="<same secret as the admin console TELEMETRY_INGEST_KEYS.rail>"
