{
  "version": 1,
  "enabled": true,
  "_docs": [
    "page_view 噪音過濾設定。修改後 commit + deploy 即生效。",
    "只影響是否寫入 page_view_logs / telemetry，不擋頁面、不擋爬蟲、不擋 AI SEO。",
    "禁止用 country / region / city 當條件（程式會忽略這類欄位）。",
    "規則為 OR：任一種命中就 skip 寫庫。",
    "fingerprintsAllMatch 內每個物件是 AND：列出的欄位都相符才命中；未列的欄位不檢查。"
  ],
  "pageView": {
    "userAgentIncludesAny": [
      "HeadlessChrome"
    ],
    "userAgentRegexAny": [],
    "fingerprintsAllMatch": [
      {
        "id": "synthetic-linux-chrome-149",
        "userAgentIncludes": "Chrome/149.0.0.0",
        "userAgentIncludesAlso": "X11; Linux x86_64",
        "timezone": "America/New_York",
        "language": "en-US",
        "screenWidth": 1920,
        "screenHeight": 1080,
        "viewportW": 1919,
        "viewportH": 992
      }
    ]
  }
}
